# ReleasePilot AI — Environment Variables

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/releasepilot"

# NextAuth / Auth (optional for MVP)
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# GitHub App (optional for MVP)
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# OpenAI (optional for MVP — mock data used in Phase 1)
OPENAI_API_KEY=""

# Redis (optional for MVP)
REDIS_URL="redis://localhost:6379"
